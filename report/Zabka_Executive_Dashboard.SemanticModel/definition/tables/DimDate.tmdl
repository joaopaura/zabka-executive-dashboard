				        {"MonthName", type text}, {"MonthShort", type text}, {"YearMonth", type text},
				        {"YearMonthNumber", Int64.Type}, {"MonthStart", type date}, {"ISOWeek", Int64.Type},
				        {"ISOYear", Int64.Type}, {"DayOfMonth", Int64.Type}, {"DayOfWeekNumber", Int64.Type},
				        {"DayName", type text}, {"DayShort", type text}, {"IsWeekend", Int64.Type},
				        {"IsHoliday", Int64.Type}, {"HolidayName", type text}, {"IsSunday", Int64.Type},
				        {"IsTradingSunday", Int64.Type}, {"IsNonTradingSunday", Int64.Type},
