	/// Conditional formatting color for [Monthly Active Users YoY %].
	measure 'Color MAU YoY' = IF ( ISBLANK ( [Monthly Active Users YoY %] ), "#8A8A8A", IF ( [Monthly Active Users YoY %] >= 0, "#1E8E3E", "#D93025" ) )
		displayFolder: 99 Formatting
