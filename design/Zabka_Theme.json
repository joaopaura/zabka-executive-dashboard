{
  "name": "Zabka Executive Light",
  "dataColors": ["#01672C", "#4FA36B", "#9CCFAE", "#F2B705", "#5F6B63", "#B8C0BA", "#0F4C81", "#D98E04", "#01461E", "#CFE6D6"],
  "background": "#FFFFFF",
  "foreground": "#1F2A22",
  "tableAccent": "#01672C",
  "good": "#1E8E3E",
  "neutral": "#F2B705",
  "bad": "#D93025",
  "maximum": "#01672C",
  "center": "#E8F3EC",
  "minimum": "#FFFFFF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A22" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F2A22" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5F6B63" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#01461E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2A22" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 12 }],
        "visualHeader": [{ "show": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#5F6B63" } }, "fontSize": 9, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#5F6B63" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#EEF0ED" } }, "gridlineStyle": "dotted" }],
        "legend": [{ "labelColor": { "solid": { "color": "#5F6B63" } }, "fontSize": 9, "position": "TopRight" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F6F4" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E9ECE8" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EEF0ED" } }, "gridVertical": false, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#01672C" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 10 }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#1F2A22" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F7FAF8" } }, "fontSize": 10 }],
        "total": [{ "fontColor": { "solid": { "color": "#01461E" } }, "backColor": { "solid": { "color": "#E8F3EC" } }, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EEF0ED" } }, "gridVertical": false, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#01672C" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 10 }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#1F2A22" } }, "fontSize": 10 }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#1F2A22" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F7FAF8" } }, "fontSize": 10 }],
        "total": [{ "fontColor": { "solid": { "color": "#01461E" } }, "backColor": { "solid": { "color": "#E8F3EC" } }, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": false }],
        "items": [{ "fontColor": { "solid": { "color": "#1F2A22" } }, "fontSize": 10 }]
      }
    }
  }
}
